{
  "appId": "app.worklog.hours",
  "appName": "שעות עבודה",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#F0FDFA",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#0D9488"
    },
    "FirebaseAuthentication": {
      "providers": ["google.com"]
    }
  }
}
