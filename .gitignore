node_modules/
# package-lock.json IS tracked: `npm ci` in the Android build needs it, and
# it's what makes the APK build reproducible.
*.log
.DS_Store
screenshot*.png
.firebase/

# Capacitor: the web assets are copied here by scripts/build-web.mjs before a
# native build. Generated, never edited — the sources live at the repo root.
www/

# Android build output and local-only SDK paths. The android/ project itself
# IS tracked, so native config (manifest, styles, icons) is reviewable and the
# CI build is reproducible.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/capacitor-cordova-android-plugins/
*.keystore
*.jks

# python cache
__pycache__/
*.pyc

# Store image tooling: fonts fetched from npm, raw app captures (regenerated by tools/store/capture.mjs)
tools/store/.fonts/
tools/store/out/
